# Metadata database holding tenants and leases.
PGLR_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pglr?sslmode=disable

# Address the Postgres-wire listener binds to.
PGLR_LISTEN_ADDR=:6432

# Maximum body size of a single protocol message, in bytes.
PGLR_MAX_MESSAGE_BYTES=16777216

# How long a client may take to finish the startup exchange.
PGLR_STARTUP_TIMEOUT=10s

# How long Serve waits for in-flight connections after cancellation.
PGLR_SHUTDOWN_TIMEOUT=10s

# One of: debug, info, warn, error.
PGLR_LOG_LEVEL=info
